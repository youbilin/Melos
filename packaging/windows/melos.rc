#include <windows.h>

1 ICON "../../assets/melos.ico"
// GPUI embeds the process manifest (DPI, supported OS and SegmentHeap).
// A second manifest resource would make the MSVC linker reject the binary.

1 VERSIONINFO
 FILEVERSION 0,1,7,0
 PRODUCTVERSION 0,1,7,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Melos music player\0"
            VALUE "FileVersion", "0.1.7\0"
            VALUE "InternalName", "melos\0"
            VALUE "OriginalFilename", "melos.exe\0"
            VALUE "ProductName", "Melos\0"
            VALUE "ProductVersion", "0.1.7\0"
            VALUE "LegalCopyright", "GPL-3.0-or-later\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
